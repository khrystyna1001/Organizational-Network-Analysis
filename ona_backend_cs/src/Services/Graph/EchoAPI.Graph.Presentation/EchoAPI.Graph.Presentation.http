@EchoAPI.Graph.Presentation_HostAddress = http://localhost:5056

### Health
GET {{EchoAPI.Graph.Presentation_HostAddress}}/
Accept: application/json

### Create board
# @name createBoard
POST {{EchoAPI.Graph.Presentation_HostAddress}}/api/v1/boards
Content-Type: application/json

{
  "name": "Engineering ONA",
  "description": "Organizational network analysis"
}

### List boards
GET {{EchoAPI.Graph.Presentation_HostAddress}}/api/v1/boards
Accept: application/json

### Read board
GET {{EchoAPI.Graph.Presentation_HostAddress}}/api/v1/boards/{{createBoard.response.body.$.id}}
Accept: application/json

### Update board
PUT {{EchoAPI.Graph.Presentation_HostAddress}}/api/v1/boards/{{createBoard.response.body.$.id}}
Content-Type: application/json

{
  "name": "Updated Engineering ONA"
}

### Add first node
# @name createFirstNode
POST {{EchoAPI.Graph.Presentation_HostAddress}}/api/v1/nodes
Content-Type: application/json

{
  "board_id": "{{createBoard.response.body.$.id}}",
  "name": "Alex",
  "title": "Director",
  "department": "Engineering"
}

### Add second node
# @name createSecondNode
POST {{EchoAPI.Graph.Presentation_HostAddress}}/api/v1/nodes
Content-Type: application/json

{
  "board_id": "{{createBoard.response.body.$.id}}",
  "name": "Sam",
  "title": "Manager",
  "department": "Engineering"
}

### List nodes in board
GET {{EchoAPI.Graph.Presentation_HostAddress}}/api/v1/nodes?board_id={{createBoard.response.body.$.id}}
Accept: application/json

### Read node
GET {{EchoAPI.Graph.Presentation_HostAddress}}/api/v1/nodes/{{createFirstNode.response.body.$.id}}
Accept: application/json

### Update node
PUT {{EchoAPI.Graph.Presentation_HostAddress}}/api/v1/nodes/{{createFirstNode.response.body.$.id}}
Content-Type: application/json

{
  "title": "Senior Director"
}

### Add connection
# @name createConnection
POST {{EchoAPI.Graph.Presentation_HostAddress}}/api/v1/connections
Content-Type: application/json

{
  "board_id": "{{createBoard.response.body.$.id}}",
  "source_node_id": "{{createFirstNode.response.body.$.id}}",
  "target_node_id": "{{createSecondNode.response.body.$.id}}",
  "weight": 1.5
}

### List connections in board
GET {{EchoAPI.Graph.Presentation_HostAddress}}/api/v1/connections?board_id={{createBoard.response.body.$.id}}
Accept: application/json

### Read connection
GET {{EchoAPI.Graph.Presentation_HostAddress}}/api/v1/connections/{{createConnection.response.body.$.id}}
Accept: application/json

### Update connection
PUT {{EchoAPI.Graph.Presentation_HostAddress}}/api/v1/connections/{{createConnection.response.body.$.id}}
Content-Type: application/json

{
  "weight": 2.0
}

### Invalid node (422 domain rejection)
POST {{EchoAPI.Graph.Presentation_HostAddress}}/api/v1/nodes
Content-Type: application/json

{
  "board_id": "{{createBoard.response.body.$.id}}",
  "name": "Invalid",
  "title": " ",
  "department": "Engineering"
}

### Missing board (404)
GET {{EchoAPI.Graph.Presentation_HostAddress}}/api/v1/boards/missing-board

### Missing required board ID (400 request validation)
POST {{EchoAPI.Graph.Presentation_HostAddress}}/api/v1/connections
Content-Type: application/json

{
  "source_node_id": "missing-source",
  "target_node_id": "missing-target"
}

### Delete connection
DELETE {{EchoAPI.Graph.Presentation_HostAddress}}/api/v1/connections/{{createConnection.response.body.$.id}}

### Delete node
DELETE {{EchoAPI.Graph.Presentation_HostAddress}}/api/v1/nodes/{{createFirstNode.response.body.$.id}}

### Delete board
DELETE {{EchoAPI.Graph.Presentation_HostAddress}}/api/v1/boards/{{createBoard.response.body.$.id}}
